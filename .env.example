# Copy to .env.local. Names only — never commit real values.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
REGISTRATION_IP_SALT=replace-with-a-long-random-string

# HttpOnly session signing. Required for the organiser dashboard.
KARIGAR_SESSION_SECRET=replace-with-a-long-random-string
KARIGAR_EVENT_ADMIN_TOKEN=replace-with-a-long-random-admin-token
KARIGAR_EVENT_VIEWER_TOKEN=replace-with-a-long-random-viewer-token

# Optional. Registration still works by typing if these are empty.
# Gemini is the primary voice path. The key stays on the server.
# Live uses a short-lived token. Speech playback uses gemini-3.8-flash-tts.
# A recorded answer uses gemini-3.5-transcribe. Do not put this key in browser code.
GEMINI_API_KEY=

# Optional Azure fallback, used only when GEMINI_API_KEY is empty.
# AZURE_SPEECH_REGION is a region name such as centralindia, not a URL.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
